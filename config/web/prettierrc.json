{
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "plugins": [
    "prettier-plugin-svelte",
    "prettier-plugin-astro",
    "@prettier/plugin-pug",
    "prettier-plugin-solidity",
    "@shopify/prettier-plugin-liquid"
