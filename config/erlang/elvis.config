%% Elvis base config (style rules; layout is erlfmt's job). why: without a config file
%% elvis checks nothing and exits 0.
[{elvis, [{config, [#{dirs => ["."], filter => "*.erl", ruleset => erl_files,
                     rules => [{elvis_text_style, line_length, disable},
                               {elvis_text_style, no_tabs, disable},
                               {elvis_text_style, no_trailing_whitespace, disable},
                               {elvis_style, operator_spaces, disable}]}]}]}].
