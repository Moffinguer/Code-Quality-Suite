# Copy to .env next to docker-compose.yml (never commit .env). Secrets: openssl rand -hex 32
# Comments go on their own lines: "KEY=   # text" would make "# text" the value of KEY.

# ---- stack secrets (required) ----
POSTGRES_PASSWORD=change-me
# admin key (UI login password); must start with sk-
LITELLM_MASTER_KEY=sk-change-me
# encrypts the keys stored in the database; never change it after the first start
LITELLM_SALT_KEY=sk-change-me

# ---- which roles: config.yaml (real work: lead/dev/review on the Anthropic API) or demo.yaml
# (free demo: every role on free tiers, PUBLIC DATA ONLY). Then: docker compose up -d --force-recreate litellm
LITELLM_CONFIG=config.yaml

# ---- provider keys: leave empty what you do not have (its models fail over to the next).
# Where to get each one: docs/AI-DEMO.md. Check them with: bash ../scripts/ai-keys.sh
# paid API key from the Anthropic Console (not your Claude subscription)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Google AI Studio
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# answers only with a topped-up balance
DEEPSEEK_API_KEY=
# build.nvidia.com (phone verification)
NVIDIA_NIM_API_KEY=
# cloud.sambanova.ai (trial credits)
SAMBANOVA_API_KEY=
# console.mistral.ai: La Plateforme key, and the separate Codestral key
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
# dashboard.cohere.com (trial key)
COHERE_API_KEY=
# github.com/settings/tokens: fine-grained token with the "Models: read" permission
GITHUB_API_KEY=
# huggingface.co/settings/tokens (only for huggingface/<model> names)
HUGGINGFACE_API_KEY=
# Cloudflare Workers AI (only for cloudflare/<model> names): API token and account id
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# add a model to litellm/config.yaml if you use it
# OPENAI_API_KEY=

# ---- optional: FreeLLMAPI pool (docker compose --profile free up -d) ----
# 64 hex characters: openssl rand -hex 32
FREELLMAPI_ENCRYPTION_KEY=
# unified key from its dashboard (http://localhost:3001, Keys page)
FREELLMAPI_KEY=

# ---- optional image pins (defaults in docker-compose.yml) ----
# LITELLM_TAG=v1.105.0
# FREELLMAPI_TAG=v0.13.7
# OLLAMA_TAG=0.40.3
