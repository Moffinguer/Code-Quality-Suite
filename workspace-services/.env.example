# Rellena SOLO las que tengas. Todas opcionales; los modelos sin key se saltan.
# --- Gratis, sin tarjeta ---
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
MISTRAL_API_KEY=       # https://console.mistral.ai  (opt-in a training)
GITHUB_API_KEY=        # PAT: https://github.com/settings/tokens (GitHub Models)
# --- De pago (baratas) ---
DEEPSEEK_API_KEY=      # https://platform.deepseek.com
ANTHROPIC_API_KEY=     # https://console.anthropic.com
# --- Clave local del gateway (no la cambies salvo que quieras) ---
LITELLM_MASTER_KEY=sk-local-master
# --- Base de datos de configuracion (jerarquia/keys/modelos) ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/agentdb
POSTGRES_PASSWORD=agent
