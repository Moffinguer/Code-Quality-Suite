{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": { "baseRef": "head" },
  "attribution": { "commit": "", "pr": "" },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<SUITE>/scripts/qs-run.sh\" --hook",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git arbol:*)",
      "Bash(git es -n:*)",
      "Bash(git np:*)",
      "Bash(git nr:*)",
      "Bash(git subir:*)",
      "Bash(git switch:*)",
      "Bash(git encoding:*)",
      "Bash(git changelog:*)",
      "Bash(bash <SUITE>/scripts/qs-run.sh:*)",
      "Bash(bash <SUITE>/scripts/ai-ask.sh:*)"
    ],
    "ask": ["Bash(git push:*)"],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push -n --no-verify:*)",
      "Bash(git release:*)",
      "Bash(git publicar:*)",
      "Bash(git combinar:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
