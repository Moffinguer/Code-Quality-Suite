#!/usr/bin/env bash
# pre-push - verify (never modify) everything being pushed, in check mode, then
# optionally run a heavy stage (project build: SpotBugs, coverage...).
# git feeds lines on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
[ -f "${HOOK_DIR}/quality-suite.env" ] && . "${HOOK_DIR}/quality-suite.env"

IMAGE="${QUALITY_SUITE_IMAGE:-code-quality-suite:latest}"
REPO_ROOT="$(git rev-parse --show-toplevel)"
Z40="0000000000000000000000000000000000000000"

ensure_image() {
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then return 0; fi
  if [ -z "${QUALITY_SUITE_DIR:-}" ] || [ ! -f "${QUALITY_SUITE_DIR}/Dockerfile" ]; then
    echo "[quality-suite] ERROR: image '$IMAGE' missing and no source to build it." >&2; exit 1
  fi
  echo "[quality-suite] Building '$IMAGE' (languages: ${QUALITY_LANGS:-none})..."
  "${QUALITY_SUITE_DIR}/scripts/build-image.sh" "${QUALITY_SUITE_DIR}" "$IMAGE" ${QUALITY_LANGS:-} || { echo "[quality-suite] ERROR building the image." >&2; exit 1; }
}
ensure_image

tmpf="$(mktemp)"; : > "$tmpf"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$Z40" ] && continue           # deleted branch
  if [ "$remote_sha" = "$Z40" ]; then             # new branch
    oldest="$(git rev-list "$local_sha" --not --remotes | tail -n 1)"
    if [ -n "$oldest" ]; then base="${oldest}^"; else base="$local_sha"; fi
    range="${base}..${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi
  git diff --name-only --diff-filter=ACM "$range" >> "$tmpf" 2>/dev/null || true
done

FILES=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "${REPO_ROOT}/${f}" ] || continue
  FILES+=("$f")
done < <(sort -u "$tmpf")
rm -f "$tmpf"

if [ "${#FILES[@]}" -gt 0 ]; then
  echo "[quality-suite] pre-push: verifying ${#FILES[@]} file(s) (check mode)..."
  # Lazy install: rebuild the image if these files introduce a new language.
  if [ -n "${QUALITY_SUITE_DIR:-}" ] && [ -x "${QUALITY_SUITE_DIR}/scripts/ensure-langs.sh" ]; then
    "${QUALITY_SUITE_DIR}/scripts/ensure-langs.sh" "${QUALITY_SUITE_DIR}" "${HOOK_DIR}/quality-suite.env" "$IMAGE" -- "${FILES[@]}"
    [ -f "${HOOK_DIR}/quality-suite.env" ] && . "${HOOK_DIR}/quality-suite.env"
  fi
  DOCKER_OPTS=(
    --rm --network none --read-only --tmpfs /tmp
    --cap-drop ALL --security-opt no-new-privileges
    -e HOME=/tmp -e QUALITY_MODE=check
    -e PMD_JAVA_VERSION="${PMD_JAVA_VERSION:-21}"
  )
  case "$(uname -s)" in
    Linux)               DOCKER_OPTS+=( --user "$(id -u):$(id -g)" ) ;;
    MINGW*|MSYS*|CYGWIN*) export MSYS_NO_PATHCONV=1 ;;
  esac
  # why: read-only mount; check mode must not rewrite anything.
  docker run "${DOCKER_OPTS[@]}" -v "${REPO_ROOT}:/workspace:ro" -w /workspace \
    "${IMAGE}" "${FILES[@]}" \
    || { echo "[quality-suite] pre-push: verification failed. Push aborted."; exit 1; }
else
  echo "[quality-suite] pre-push: nothing new to verify."
fi

# Optional heavy stage (real project build). Runs on the host (needs its toolchain).
# Enable it by setting QUALITY_HEAVY_CMD in quality-suite.env, e.g. "mvn -B verify".
if [ -n "${QUALITY_HEAVY_CMD:-}" ]; then
  echo "[quality-suite] pre-push: heavy stage -> ${QUALITY_HEAVY_CMD}"
  ( cd "${REPO_ROOT}" && eval "${QUALITY_HEAVY_CMD}" ) \
    || { echo "[quality-suite] pre-push: heavy stage failed. Push aborted."; exit 1; }
fi

echo "[quality-suite] pre-push OK"
exit 0
