#!/usr/bin/env bash
# =============================================================================
# pre-push — verifica (NO modifica) todo lo que se va a empujar, en modo check,
# y opcionalmente lanza una etapa pesada (build del proyecto: SpotBugs, cobertura).
# git pasa por stdin lineas: <local_ref> <local_sha> <remote_ref> <remote_sha>
# =============================================================================
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
[ -f "${HOOK_DIR}/quality-suite.env" ] && . "${HOOK_DIR}/quality-suite.env"

IMAGE="${QUALITY_SUITE_IMAGE:-code-quality-suite:latest}"
REPO_ROOT="$(git rev-parse --show-toplevel)"
Z40="0000000000000000000000000000000000000000"

ensure_image() {
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then return 0; fi
  if [ -z "${QUALITY_SUITE_DIR:-}" ] || [ ! -f "${QUALITY_SUITE_DIR}/Dockerfile" ]; then
    echo "[quality-suite] ERROR: imagen '$IMAGE' ausente y sin fuente para construirla." >&2; exit 1
  fi
  echo "[quality-suite] Construyendo '$IMAGE' por primera vez..."
  docker build -t "$IMAGE" "${QUALITY_SUITE_DIR}" || { echo "[quality-suite] ERROR al construir." >&2; exit 1; }
}
ensure_image

# Recopila los ficheros del rango que se empuja.
tmpf="$(mktemp)"; : > "$tmpf"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$Z40" ] && continue          # rama borrada
  if [ "$remote_sha" = "$Z40" ]; then            # rama nueva
    oldest="$(git rev-list "$local_sha" --not --remotes | tail -n 1)"
    if [ -n "$oldest" ]; then base="${oldest}^"; else base="$local_sha"; fi
    range="${base}..${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi
  git diff --name-only --diff-filter=ACM "$range" >> "$tmpf" 2>/dev/null || true
done

FILES=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "${REPO_ROOT}/${f}" ] || continue
  FILES+=("$f")
done < <(sort -u "$tmpf")
rm -f "$tmpf"

if [ "${#FILES[@]}" -gt 0 ]; then
  echo "[quality-suite] pre-push: verificando ${#FILES[@]} fichero(s) (modo check)..."
  DOCKER_OPTS=(
    --rm --network none --read-only --tmpfs /tmp
    --cap-drop ALL --security-opt no-new-privileges
    -e HOME=/tmp -e QUALITY_MODE=check
    -e PMD_JAVA_VERSION="${PMD_JAVA_VERSION:-21}"
  )
  case "$(uname -s)" in
    Linux)               DOCKER_OPTS+=( --user "$(id -u):$(id -g)" ) ;;
    MINGW*|MSYS*|CYGWIN*) export MSYS_NO_PATHCONV=1 ;;
  esac
  # Montaje de solo lectura: en check no se debe reescribir nada.
  docker run "${DOCKER_OPTS[@]}" -v "${REPO_ROOT}:/workspace:ro" -w /workspace \
    "${IMAGE}" "${FILES[@]}" \
    || { echo "[quality-suite] pre-push: verificacion fallida. Push abortado."; exit 1; }
else
  echo "[quality-suite] pre-push: nada nuevo que verificar."
fi

# --- Etapa pesada opcional (build real del proyecto: SpotBugs, cobertura...) ---
# Necesita el toolchain del proyecto (JDK/Maven), por eso corre en el host.
# Se activa poniendo QUALITY_HEAVY_CMD en quality-suite.env, p.ej. "mvn -B verify".
if [ -n "${QUALITY_HEAVY_CMD:-}" ]; then
  echo "[quality-suite] pre-push: etapa pesada -> ${QUALITY_HEAVY_CMD}"
  ( cd "${REPO_ROOT}" && eval "${QUALITY_HEAVY_CMD}" ) \
    || { echo "[quality-suite] pre-push: etapa pesada fallida. Push abortado."; exit 1; }
fi

echo "[quality-suite] pre-push OK"
exit 0
