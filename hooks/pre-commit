#!/usr/bin/env bash
# pre-commit - format and analyze staged files; block the commit on failure.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
[ -f "${HOOK_DIR}/quality-suite.env" ] && . "${HOOK_DIR}/quality-suite.env"

IMAGE="${QUALITY_SUITE_IMAGE:-code-quality-suite:latest}"
REPO_ROOT="$(git rev-parse --show-toplevel)"

ensure_image() {
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then return 0; fi
  if [ -z "${QUALITY_SUITE_DIR:-}" ] || [ ! -f "${QUALITY_SUITE_DIR}/Dockerfile" ]; then
    echo "[quality-suite] ERROR: image '$IMAGE' missing and no source to build it (QUALITY_SUITE_DIR)." >&2
    exit 1
  fi
  echo "[quality-suite] Image '$IMAGE' not found; building (languages: ${QUALITY_LANGS:-none})..."
  "${QUALITY_SUITE_DIR}/scripts/build-image.sh" "${QUALITY_SUITE_DIR}" "$IMAGE" ${QUALITY_LANGS:-} \
    || { echo "[quality-suite] ERROR building the image." >&2; exit 1; }
}
ensure_image

# why: no mapfile, to stay compatible with macOS bash 3.2.
STAGED=()
while IFS= read -r line; do
  [ -n "$line" ] && STAGED+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACM)

[ "${#STAGED[@]}" -eq 0 ] && exit 0
echo "[quality-suite] Analyzing ${#STAGED[@]} staged file(s)..."

# Lazy install: rebuild the image if these files introduce a new language.
if [ -n "${QUALITY_SUITE_DIR:-}" ] && [ -x "${QUALITY_SUITE_DIR}/scripts/ensure-langs.sh" ]; then
  "${QUALITY_SUITE_DIR}/scripts/ensure-langs.sh" "${QUALITY_SUITE_DIR}" "${HOOK_DIR}/quality-suite.env" "$IMAGE" -- "${STAGED[@]}"
  [ -f "${HOOK_DIR}/quality-suite.env" ] && . "${HOOK_DIR}/quality-suite.env"
fi

DOCKER_OPTS=(
  --rm --network none --read-only --tmpfs /tmp
  --cap-drop ALL --security-opt no-new-privileges
  -e HOME=/tmp
  -e QUALITY_MODE=fix
  -e PMD_JAVA_VERSION="${PMD_JAVA_VERSION:-21}"
)
case "$(uname -s)" in
  Linux)               DOCKER_OPTS+=( --user "$(id -u):$(id -g)" ) ;;
  MINGW*|MSYS*|CYGWIN*) export MSYS_NO_PATHCONV=1 ;;
esac

if docker run "${DOCKER_OPTS[@]}" -v "${REPO_ROOT}:/workspace" -w /workspace \
     "${IMAGE}" "${STAGED[@]}"; then
  container_rc=0
else
  container_rc=$?
fi

# why: re-stage what the formatter rewrote (partial-staging note in README).
for f in "${STAGED[@]}"; do
  [ -f "${REPO_ROOT}/${f}" ] && git add -- "${f}"
done

if [ "${container_rc}" -ne 0 ]; then
  echo "[quality-suite] Analysis found problems. Commit aborted."
  exit "${container_rc}"
fi
echo "[quality-suite] OK"
exit 0
