#!/usr/bin/env bash
# code-quality-suite hook
# prepare-commit-msg - put the "Files:" block (status + path of every modified file, see
# scripts/commit-files-lib.sh) into every commit message: a template for editor commits, the
# message itself for -m/-F, merge, squash and amend. commit.files = off disables it.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/../scripts/hook-lib.sh"
qs_hook_env

MSG_FILE="$1"
SOURCE="${2:-}"
ARG3="${3:-}"

qs_hook_flow_lib --no-docker || true

files_block=""
FILES_LIB="${QUALITY_SUITE_DIR:-}/scripts/commit-files-lib.sh"
if [ "${QS_COMMIT_FILES:-block}" != off ] && [ -f "$FILES_LIB" ]; then
	# shellcheck disable=SC1090
	. "$FILES_LIB"
	rm -f "$(git rev-parse --git-path quality-suite)/FILES_BLOCK"
	# why: quotePath (inside the lib) keeps accented file names as ASCII escapes
	files_block="$(qs_commit_files_block "$SOURCE" "$ARG3")"
	qs_files_store "$files_block"
fi

# Not an editor commit (-m, -F, merge, squash, amend...): the block goes into the message itself.
case "$SOURCE" in
"" | template) : ;;
*)
	[ -z "$files_block" ] || qs_message_set_files "$MSG_FILE" "$files_block"
	exit 0
	;;
esac

TYPES="${QS_COMMIT_TYPES:-feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert}"
TYPES="${TYPES//|/, }"

tmp="$(mktemp)"
{
	echo "<type>(scope): short description (<=${QS_COMMIT_SUBJECT_MAX:-50} chars, ASCII only)"
	echo ""
	if [ -n "$files_block" ]; then printf '%s\n\n' "$files_block"; fi
	cat <<TPL
# -- Conventional Commits -------------------------------------
# Subject (1st line):  <type>[(scope)][!]: <description>
#   imperative, <=${QS_COMMIT_SUBJECT_MAX:-50} chars, no trailing period, ASCII only
#   (no accents or n-tilde: commit.charset in .quality-rules.json).
# Types: ${TYPES}
#
# Body (optional, after a blank line): the what and the why (<=72/line).
# The Files: block above is kept by commit-msg (commit.files); put trailers
# (Norms:, Refs:) in the last paragraph, below it.
# Footer (optional): "Refs: #123", "Reviewed-by: ...".
# Breaking change: "feat!: ..."  or footer  "BREAKING CHANGE: ...".
#
# Example:
#   feat(parser): support empty arrays
#
#   It used to throw NPE on []. Now it returns an empty list.
#
#   BREAKING CHANGE: parse() no longer accepts null.
# -------------------------------------------------------------
TPL
	cat "$MSG_FILE"
} >"$tmp"
mv "$tmp" "$MSG_FILE"
exit 0
