#!/usr/bin/env bash
# prepare-commit-msg - preload a Conventional Commits template with the commit
# file manifest (A/M/D...), uncommented and editable.
set -euo pipefail
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
[ -f "${HOOK_DIR}/quality-suite.env" ] && . "${HOOK_DIR}/quality-suite.env"

MSG_FILE="$1"
SOURCE="${2:-}"

# Editor commits only (skip -m, merge, squash, commit -c...).
case "$SOURCE" in
  ""|template) : ;;
  *) exit 0 ;;
esac

TYPES="${COMMIT_TYPES_HUMAN:-feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert}"
manifest="$(git diff --cached --name-status --diff-filter=ACMRD 2>/dev/null | awk '{print substr($1,1,1), $NF}')"

tmp="$(mktemp)"
{
  echo "<type>(scope): short description (<=50 chars)"
  echo ""
  echo "# Commit files (become part of the body; edit or delete):"
  [ -n "$manifest" ] && printf '%s\n' "$manifest"
  echo ""
  cat <<TPL
# -- Conventional Commits -------------------------------------
# Subject (1st line):  <type>[(scope)][!]: <description>
#   imperative, <=50 chars, no trailing period.
# Types: ${TYPES}
#
# Body (optional, after a blank line): the what and the why (<=72/line).
# Footer (optional): "Refs: #123", "Reviewed-by: ...".
# Breaking change: "feat!: ..."  or footer  "BREAKING CHANGE: ...".
#
# Example:
#   feat(parser): support empty arrays
#
#   It used to throw NPE on []. Now it returns an empty list.
#
#   BREAKING CHANGE: parse() no longer accepts null.
# -------------------------------------------------------------
TPL
  cat "$MSG_FILE"
} > "$tmp"
mv "$tmp" "$MSG_FILE"
exit 0
