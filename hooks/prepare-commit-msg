#!/usr/bin/env bash
# code-quality-suite hook
# prepare-commit-msg - preload a Conventional Commits template with the commit
# file manifest (A/M/D...), uncommented and editable.
set -euo pipefail
HOOK_DIR="${QS_HOOK_DIR:-$(cd "$(dirname "$0")" && pwd)}"; unset QS_HOOK_DIR   # set by the repo wrapper; not inherited further
[ -f "${HOOK_DIR}/quality-suite.env" ] && . "${HOOK_DIR}/quality-suite.env"

MSG_FILE="$1"
SOURCE="${2:-}"

# Editor commits only (skip -m, merge, squash, commit -c...).
case "$SOURCE" in
  ""|template) : ;;
  *) exit 0 ;;
esac

LIB="${QUALITY_SUITE_DIR:-}/scripts/git-flow-lib.sh"
# shellcheck disable=SC1090
if [ -f "$LIB" ]; then . "$LIB"; QS_POLICY_NO_DOCKER=1 qs_policy_load; fi
TYPES="${QS_COMMIT_TYPES:-feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert}"; TYPES="${TYPES//|/, }"
# why: quotePath keeps accented file names as ASCII escapes (the message must stay ASCII)
manifest="$(git -c core.quotePath=true diff --cached --name-status --diff-filter=ACMRD 2>/dev/null \
  | sed -E 's/^([A-Z])[0-9]*\t([^\t]*\t)?/\1 /')"

tmp="$(mktemp)"
{
  echo "<type>(scope): short description (<=${QS_COMMIT_SUBJECT_MAX:-50} chars, ASCII only)"
  echo ""
  echo "# Commit files (become part of the body; edit or delete):"
  [ -n "$manifest" ] && printf '%s\n' "$manifest"
  echo ""
  cat <<TPL
# -- Conventional Commits -------------------------------------
# Subject (1st line):  <type>[(scope)][!]: <description>
#   imperative, <=${QS_COMMIT_SUBJECT_MAX:-50} chars, no trailing period, ASCII only
#   (no accents or n-tilde: commit.charset in .quality-rules.json).
# Types: ${TYPES}
#
# Body (optional, after a blank line): the what and the why (<=72/line).
# Footer (optional): "Refs: #123", "Reviewed-by: ...".
# Breaking change: "feat!: ..."  or footer  "BREAKING CHANGE: ...".
#
# Example:
#   feat(parser): support empty arrays
#
#   It used to throw NPE on []. Now it returns an empty list.
#
#   BREAKING CHANGE: parse() no longer accepts null.
# -------------------------------------------------------------
TPL
  cat "$MSG_FILE"
} > "$tmp"
mv "$tmp" "$MSG_FILE"
exit 0
