;; qs-org-lint.el - org-lint in batch: emacs -Q --batch -l qs-org-lint.el FILE...  (exit 1 on findings)
(require 'org)
(require 'org-lint)
(let ((rc 0))
  (dolist (f command-line-args-left)
    (with-temp-buffer
      (insert-file-contents f)
      (setq buffer-file-name (expand-file-name f))
      (delay-mode-hooks (org-mode))
      (dolist (r (org-lint))
        (let ((v (cadr r)))
          (princ (format "%s:%s: %s (%s)\n" f (aref v 0) (aref v 2)
                         (org-lint-checker-name (aref v 3))))
          (setq rc 1)))))
  (setq command-line-args-left nil)
  (kill-emacs rc))
